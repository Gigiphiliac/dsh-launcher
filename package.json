{
  "name": "dsh-launcher",
  "displayName": "DSH Launcher",
  "description": "Launch and open a local DSH instance from within VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gigiphiliac/dsh-launcher.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-launcher",
          "title": "DSH",
          "icon": "resources/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-launcher": [
        {
          "type": "webview",
          "id": "dsh-launcher.view",
          "name": "DSH",
          "icon": "resources/dsh.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh-launcher.launch",
        "title": "DSH Launcher: Launch"
      },
      {
        "command": "dsh-launcher.openSidebar",
        "title": "DSH Launcher: Open in Sidebar"
      },
      {
        "command": "dsh-launcher.openEditor",
        "title": "DSH Launcher: Open in Editor"
      }
    ],
    "configuration": {
      "title": "DSH Launcher",
      "properties": {
        "dsh-launcher.command": {
          "type": "string",
          "default": "dsh",
          "description": "DSH executable."
        },
        "dsh-launcher.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "web",
            "--no-open"
          ],
          "description": "Arguments passed to DSH."
        },
        "dsh-launcher.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "URL of the local DSH server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}